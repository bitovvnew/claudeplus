{
  "name": "claudeplus",
  "version": "0.1.0",
  "description": "The open-source power-up layer for Claude Code: local cost tracking, leak detection, token-saving Guard hook, live dashboard, statusline themes and a 62-agent library. Zero dependencies, 16 languages.",
  "type": "module",
  "bin": {
    "cplus": "bin/cplus.js",
    "claudeplus": "bin/cplus.js"
  },
  "files": [
    "bin",
    "src",
    "dashboard",
    "locales",
    "library",
    "assets/logo.svg",
    "plugin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/cplus.js dash",
    "demo": "node bin/cplus.js demo",
    "test": "node --test test/",
    "bench": "node scripts/bench.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "library": "node scripts/build-library.mjs && node scripts/agents-doc.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "llm",
    "cost",
    "tokens",
    "usage",
    "dashboard",
    "statusline",
    "agents",
    "subagents",
    "hooks",
    "cli"
  ],
  "license": "MIT"
}
